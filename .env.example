# --- OpenAI (required) ---
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.5

# --- Shared secret between the Apps Script sidebar and this backend (required) ---
# Put the same value in the Apps Script "Script Properties" as API_KEY.
GRIDCOACH_API_KEY=pick-a-long-random-string

# --- Public URL of this backend. scripts/dev.sh sets this for you when it starts a tunnel. ---
PUBLIC_BASE_URL=http://localhost:8000
# Free ngrok static domain (dashboard.ngrok.com -> Domains). With this set, dev.sh uses ngrok and the URL never changes.
NGROK_DOMAIN=

# --- Strava (https://www.strava.com/settings/api) ---
STRAVA_CLIENT_ID=123456
STRAVA_CLIENT_SECRET=abcdef...
STRAVA_VERIFY_TOKEN=gridcoach-verify

# --- Google Sheets access: service-account JSON. Share each sheet with the client_email inside it. ---
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json

# --- Optional ---
DATABASE_PATH=./backend/gridcoach.db
DEFAULT_LOOKBACK_DAYS=90
